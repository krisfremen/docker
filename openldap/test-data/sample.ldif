# Sample LDIF data for testing OpenLDAP container
# Base DN: dc=example,dc=com

# Root entry
dn: dc=example,dc=com
objectClass: top
objectClass: dcObject
objectClass: organization
o: Example Organisation
dc: example

# Organizational Unit for users
dn: ou=users,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: users
description: User entries

# Organizational Unit for groups
dn: ou=groups,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: groups
description: Group entries

# Sample user 1
dn: uid=testuser1,ou=users,dc=example,dc=com
objectClass: top
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: testuser1
sn: User
givenName: Test
cn: Test User
displayName: Test User
uidNumber: 1000
gidNumber: 1000
userPassword: {SSHA}testpassword123
gecos: Test User
loginShell: /bin/bash
homeDirectory: /home/testuser1
mail: testuser1@example.com

# Sample user 2
dn: uid=testuser2,ou=users,dc=example,dc=com
objectClass: top
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: testuser2
sn: User
givenName: Test
cn: Test User 2
displayName: Test User 2
uidNumber: 1001
gidNumber: 1001
userPassword: {SSHA}testpassword456
gecos: Test User 2
loginShell: /bin/bash
homeDirectory: /home/testuser2
mail: testuser2@example.com

# Sample group
dn: cn=testgroup,ou=groups,dc=example,dc=com
objectClass: top
objectClass: posixGroup
cn: testgroup
gidNumber: 2000
memberUid: testuser1
memberUid: testuser2

